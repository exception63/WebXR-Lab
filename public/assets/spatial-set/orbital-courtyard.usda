#usda 1.0
(
    defaultPrim = "OrbitalCourtyard"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "OrbitalCourtyard"
{
    def Scope "Looks"
    {
        def Material "DarkMetal"
        {
            token outputs:surface.connect = </OrbitalCourtyard/Looks/DarkMetal/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.018, 0.045, 0.04)
                float inputs:metallic = 0.82
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "MintGlass"
        {
            token outputs:surface.connect = </OrbitalCourtyard/Looks/MintGlass/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.08, 0.72, 0.52)
                color3f inputs:emissiveColor = (0.04, 0.5, 0.34)
                float inputs:metallic = 0.2
                float inputs:roughness = 0.18
                float inputs:opacity = 0.82
                token outputs:surface
            }
        }

        def Material "AmberGlass"
        {
            token outputs:surface.connect = </OrbitalCourtyard/Looks/AmberGlass/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.95, 0.38, 0.08)
                color3f inputs:emissiveColor = (0.65, 0.18, 0.025)
                float inputs:metallic = 0.18
                float inputs:roughness = 0.2
                float inputs:opacity = 0.86
                token outputs:surface
            }
        }

        def Material "Ivory"
        {
            token outputs:surface.connect = </OrbitalCourtyard/Looks/Ivory/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.66, 0.74, 0.69)
                float inputs:metallic = 0.12
                float inputs:roughness = 0.62
                token outputs:surface
            }
        }
    }

    def Cylinder "Floor"
    {
        token axis = "Y"
        float height = 0.08
        float radius = 4.0
        rel material:binding = </OrbitalCourtyard/Looks/DarkMetal>
        double3 xformOp:translate = (0, -0.06, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Cylinder "InnerDais"
    {
        token axis = "Y"
        float height = 0.06
        float radius = 1.3
        rel material:binding = </OrbitalCourtyard/Looks/Ivory>
        double3 xformOp:translate = (0, 0.01, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "MintArch"
    {
        double3 xformOp:translate = (-2.65, 0, -2.25)
        double3 xformOp:rotateXYZ = (0, 26, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def Cube "LeftPillar"
        {
            double size = 1
            rel material:binding = </OrbitalCourtyard/Looks/DarkMetal>
            double3 xformOp:scale = (0.18, 1.38, 0.18)
            double3 xformOp:translate = (-0.82, 1.38, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "RightPillar"
        {
            double size = 1
            rel material:binding = </OrbitalCourtyard/Looks/DarkMetal>
            double3 xformOp:scale = (0.18, 1.38, 0.18)
            double3 xformOp:translate = (0.82, 1.38, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
