    def Cylinder "NorthMarker"
    {
        token axis = "Y"
        float height = 1.8
        float radius = 0.08
        rel material:binding = </OrbitalCourtyard/Looks/Ivory>
        double3 xformOp:translate = (0, 0.9, 3.55)
