        {
            double size = 1
            rel material:binding = </OrbitalCourtyard/Looks/MintGlass>
            double3 xformOp:scale = (1.0, 0.16, 0.22)
            double3 xformOp:translate = (0, 2.72, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "Beacon"
        {
            double radius = 0.24
            rel material:binding = </OrbitalCourtyard/Looks/MintGlass>
            double3 xformOp:translate = (0, 2.18, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "AmberArch"
    {
        double3 xformOp:translate = (2.65, 0, -2.25)
        double3 xformOp:rotateXYZ = (0, -26, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]

        def Cube "LeftPillar"
        {
            double size = 1
