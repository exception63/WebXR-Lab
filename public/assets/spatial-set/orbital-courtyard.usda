            double3 xformOp:translate = (0.82, 1.38, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Cube "Lintel"
        {
            double size = 1
            rel material:binding = </OrbitalCourtyard/Looks/AmberGlass>
            double3 xformOp:scale = (1.0, 0.16, 0.22)
            double3 xformOp:translate = (0, 2.72, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
        def Sphere "Beacon"
        {
            double radius = 0.24
            rel material:binding = </OrbitalCourtyard/Looks/AmberGlass>
            double3 xformOp:translate = (0, 2.18, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "SideMonoliths"
    {
        def Cube "Left"
        {
            double size = 1
            rel material:binding = </OrbitalCourtyard/Looks/MintGlass>
            double3 xformOp:scale = (0.22, 0.9, 0.22)
            double3 xformOp:translate = (-3.35, 0.9, 0.65)
            double3 xformOp:rotateXYZ = (0, -18, -5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
        def Cube "Right"
        {
            double size = 1
            rel material:binding = </OrbitalCourtyard/Looks/AmberGlass>
            double3 xformOp:scale = (0.22, 1.08, 0.22)
            double3 xformOp:translate = (3.35, 1.08, 0.65)
            double3 xformOp:rotateXYZ = (0, 18, 5)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
